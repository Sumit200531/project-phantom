[layer_names]

3d_render/layer_1="World"
3d_render/layer_2="Viewmodel"
3d_physics/layer_1="World"
3d_physics/layer_2="Units"
3d_physics/layer_3="Hitboxes"
3d_physics/layer_4="BarrierTeam0"
3d_physics/layer_5="BarrierTeam1"
3d_physics/layer_6="SpawnWalls"
3d_physics/layer_7="Device"

[navigation]

3d/default_cell_height=0.2

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.1, 1)
anti_aliasing/quality/screen_space_aa=1
